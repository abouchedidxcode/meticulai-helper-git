{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "@webgpu/types"]
	},
	"include": ["src", "recipe.json"]
}
