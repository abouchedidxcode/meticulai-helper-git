{
	"project": "blendi/slice-anything",
	"version": "1.0.1",
	"channel": "private",
	"files": "dist",
	"recipe": {
		"mode": "browser",
		"block": {
			"controls": [
				{
					"id": "blade",
					"label": "Blade",
					"hint": "Which sword is in hand: the katana is quick and light, the longsword slower, longer and heavier.",
					"type": "choice",
					"options": [
						{
							"value": "katana",
							"label": "Katana"
						},
						{
							"value": "longsword",
							"label": "Longsword"
						}
					],
					"default": "katana",
					"essential": true
				},
				{
					"id": "speed",
					"label": "Speed",
					"hint": "How fast time runs: below 1 is slow motion.",
					"type": "number",
					"min": 0.1,
					"max": 1,
					"step": 0.05,
					"default": 1,
					"unit": "×",
					"essential": true
				},
				{
					"id": "line",
					"label": "Cut line",
					"hint": "Draws, on everything in reach, the line the blade would cut along. Holding the right mouse button shows it too.",
					"type": "toggle",
					"default": false,
					"essential": true
				},
				{
					"id": "gravity",
					"label": "Gravity",
					"hint": "How hard cut pieces fall.",
					"type": "number",
					"min": 1,
					"max": 20,
					"step": 0.1,
					"default": 9.8,
					"unit": "m/s²"
				},
				{
					"id": "budget",
					"label": "Cutting per frame",
					"hint": "Milliseconds of cutting a frame. A swing through a heap of pieces is worked off within this, over as many frames as it takes.",
					"type": "number",
					"min": 1,
					"max": 12,
					"step": 0.5,
					"default": 5,
					"unit": "ms"
				},
				{
					"id": "hold",
					"label": "Blade bites",
					"hint": "Whether the blade is held for an instant in the first thing it meets.",
					"type": "toggle",
					"default": true
				},
				{
					"id": "shake",
					"label": "Camera shake",
					"hint": "Whether the view shakes when the blade bites.",
					"type": "toggle",
					"default": true
				}
			],
			"presets": [],
			"triggers": [
				{
					"id": "reset",
					"label": "Reset",
					"hint": "Puts everything back whole, and you back where you started."
				}
			]
		},
		"test": {
			"move_keys": [
				"KeyW",
				"ArrowUp"
			]
		},
